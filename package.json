{
  "name": "work-pa",
  "version": "1.0.0",
  "description": "Personal work & team manager - a lightweight PA for a tech lead",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm --prefix client run dev",
    "create-user": "node server/scripts/createUser.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "postinstall": "npm --prefix client install --include=dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "imapflow": "^1.7.6",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.16",
    "mongoose": "^8.9.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
