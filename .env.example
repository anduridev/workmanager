# MongoDB connection string (Railway: add the MongoDB plugin and reference ${{MongoDB.MONGO_URL}})
MONGO_URI=mongodb://localhost:27017/workpa

# Secret used to sign session tokens
JWT_SECRET=change-this-to-a-long-random-string

# Timezone used by the reminder scheduler and date handling
TZ=Asia/Kolkata

# Port (Railway injects this automatically)
PORT=5000

# ---- Notifications ----
# Web Push (VAPID) keys are generated automatically and stored in MongoDB. Set these only to pin your own.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Morning digest: one notification per day summarising the day (in-app + push)
# DIGEST_HOUR=9
# DIGEST_MINUTE=0
# DIGEST_WEEKDAYS_ONLY=true

# ---- Azure DevOps / TFS sync (optional) ----
# Projects -> Product Backlog Items (current sprint), tasks -> child Tasks (sprint matching the task's due date),
# task notes -> discussion entries. Works with dev.azure.com and on-prem TFS / Azure DevOps Server.
# NEVER put real secrets in this file — copy it to .env (gitignored) and fill values there.
AZDO_ORG_URL=http://your-tfs-server:8080/tfs/DefaultCollection   # or https://dev.azure.com/<org>
AZDO_PROJECT=Your Project Name
AZDO_USERNAME=DOMAIN\user          # optional with a PAT; required with AZDO_PASSWORD
AZDO_PAT=                          # personal access token (Work Items: Read & write). Leave empty to disable.
# AZDO_PASSWORD=                   # alternative to a PAT: basic auth (must be enabled on the TFS server)
# AZDO_PBI_TYPE=Product Backlog Item
# AZDO_PBI_STATE=Approved          # state given to newly created PBIs (empty = leave the process default "New")
# AZDO_TASK_TYPE=Task
# AZDO_STATE_MAP={"todo":"To Do","inprogress":"In Progress","hold":"To Do","done":"Done"}
# For the Agile process: AZDO_PBI_TYPE=User Story  AZDO_STATE_MAP={"todo":"New","inprogress":"Active","hold":"New","done":"Closed"}
# AZDO_SPRINT_BY_DATE=true         # pick the sprint whose dates contain the task date
# AZDO_ASSIGN_TO=                  # identity for "Assigned To" on new items, e.g. "Name <DOMAIN\user>". Default: the PAT's own user
# AZDO_PLACE_ON_TOP=true           # new items go to the top of the sprint backlog (so they're visible at once)
# AZDO_ITERATION_PATH=Your Project Name\Backlog   # used when no sprint matches the date
# AZDO_AREA_PATH=Your Project Name\Team A
# AZDO_API_VERSION=                # auto-detected (7.1 … 3.0); pin only if needed
# AZDO_SYNC_ORPHAN_TASKS=true      # also mirror tasks that have no project (as standalone Tasks)
